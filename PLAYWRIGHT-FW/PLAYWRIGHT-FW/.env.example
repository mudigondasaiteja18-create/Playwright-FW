# Playwright Framework - Environment Configuration
# Copy this file to .env and fill in your values

# ========================================
# ENVIRONMENT SELECTION
# ========================================
# Options: beta, staging, prod, development
ENVIRONMENT=staging

# ========================================
# BETA ENVIRONMENT URLs
# ========================================
BETA_BASE_URL=https://en-us.beta.ftsites.com
BETA_API_URL=https://beta-api.franklintempleton.com/api

# ========================================
# STAGING ENVIRONMENT URLs
# ========================================
STAGING_BASE_URL=https://staging.franklintempleton.com
STAGING_API_URL=https://staging-api.franklintempleton.com/api

# ========================================
# PRODUCTION ENVIRONMENT URLs
# ========================================
PROD_BASE_URL=https://www.franklintempleton.com
PROD_API_URL=https://api.franklintempleton.com/api

# ========================================
# DEVELOPMENT ENVIRONMENT URLs
# ========================================
DEV_BASE_URL=http://localhost:3000
DEV_API_URL=http://localhost:3001/api

# ========================================
# BROWSER CONFIGURATION
# ========================================
# Run tests in headless mode (true/false)
HEADLESS=true

# Slow down test execution (milliseconds)
SLOW_MO=0

# Open developer tools (true/false)
DEVTOOLS=false

# ========================================
# TIMEOUT CONFIGURATION (milliseconds)
# ========================================
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=30000
ACTION_TIMEOUT=10000

# ========================================
# LOGGING CONFIGURATION
# ========================================
# Log levels: debug, info, warn, error
LOG_LEVEL=info

# ========================================
# RETRY CONFIGURATION
# ========================================
MAX_RETRIES=2
RETRY_DELAY=1000

# ========================================
# CREDENTIALS (Use securely in CI/CD)
# ========================================
TEST_USER_EMAIL=testuser@example.com
TEST_USER_PASSWORD=YourSecurePassword123

# ========================================
# REPORT CONFIGURATION
# ========================================
REPORT_DIR=test-reports
ALLURE_RESULTS_DIR=allure-results

# ========================================
# CI/CD INDICATORS
# ========================================
# Set to true in CI environments
CI=false
