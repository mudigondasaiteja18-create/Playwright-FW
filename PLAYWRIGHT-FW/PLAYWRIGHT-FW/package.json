{
  "name": "playwright-framework",
  "version": "1.0.0",
  "description": "Enterprise-grade Playwright testing framework with POM, Allure reporting, and best practices",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:all-browsers": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:beta": "cross-env ENVIRONMENT=beta playwright test",
    "test:staging": "cross-env ENVIRONMENT=staging playwright test",
    "test:prod": "cross-env ENVIRONMENT=prod playwright test",
    "test:dev": "cross-env ENVIRONMENT=development playwright test",
    "test:beta:debug": "cross-env ENVIRONMENT=beta playwright test --debug",
    "test:staging:debug": "cross-env ENVIRONMENT=staging playwright test --debug",
    "test:prod:debug": "cross-env ENVIRONMENT=prod playwright test --debug",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "codegen": "playwright codegen",
    "trace:show": "playwright show-trace",
    "mcp:launch": "node mcp-helper.js launch",
    "mcp:run-test": "node mcp-helper.js run-test",
    "mcp:record": "node mcp-helper.js record",
    "mcp:inspect": "node mcp-helper.js inspect"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "e2e",
    "pom"
  ],
  "author": "QA Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.10.0",
    "allure-playwright": "^3.0.0",
    "allure-commandline": "^2.30.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7"
  }
}
